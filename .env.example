# ==========================================
# DATABASE CONFIGURATION
# ==========================================
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=pfe_db
MYSQL_USER=pfe_user
MYSQL_PASSWORD=your_secure_db_password

# ==========================================
# JWT & SECURITY
# ==========================================
# Generate a strong 256-bit hex string for production
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ACCESS_EXPIRY_MS=9000000
JWT_REFRESH_EXPIRY_MS=604800000
VERIFICATION_CODE_EXPIRY_MINUTES=15
X_API_KEY=your_secure_n8n_webhook_key

# ==========================================
# EXTERNAL APIs (LLMs & OCR)
# ==========================================
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_LOG_PAYLOADS=false

NVIDIA_API_KEY=nvapi-your-nvidia-key-here
OCR_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v1

# ==========================================
# AUTOMATION (n8n)
# ==========================================
USE_N8N=false
N8N_EVALUATION_URL=http://localhost:5600/webhook/cv-analysis
N8N_STRUCTURED_JD_URL=http://localhost:5680/webhook/structured-jd

# ==========================================
# EMAIL SMTP CONFIGURATION
# ==========================================
USE_SMTP=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password

MAILERSEND_API_KEY=mlsn.your_mailersend_api_key
MAILERSEND_SENDER_EMAIL=Talent@your_domain.com
MAILERSEND_SENDER_NAME=Djezzy Talent

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
SERVER_PORT=8080
FILE_UPLOAD_DIR=uploads
COMPANY_NAME=DJEZZY
# Use exact domain in production (e.g. https://yourdomain.com), do not use *
FRONTEND_URLS=http://localhost:3000

# ==========================================
# SYSTEM ADMIN
# ==========================================
ADMIN_USERNAME=admin
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=your_strong_admin_password

# ==========================================
# BACKEND LOGGING
# Available levels: TRACE, DEBUG, INFO, WARN, ERROR, FATAL, OFF
# ==========================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SECURITY=INFO
LOGGING_LEVEL_WEB=INFO
LOGGING_LEVEL_WORKFLOW=INFO
LOGGING_LEVEL_HIBERNATE=WARN
LOGGING_LEVEL_HIBERNATE_BINDER=WARN
